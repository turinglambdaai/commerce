[Unit]
Description=Commerce Permit issuer/projector (no public HTTP listener)
After=local-fs.target

[Service]
Type=simple
User=commerce-issuer
Group=commerce-shared
UMask=0007
WorkingDirectory=/var/lib/commerce
ExecStart=/usr/bin/racket /opt/commerce/examples/service.rkt
Environment=COMMERCE_ROLE=issuer
Environment=COMMERCE_DB_PATH=/var/lib/commerce/commerce.sqlite
EnvironmentFile=/etc/commerce/issuer.env
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/commerce
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes

[Install]
WantedBy=multi-user.target
