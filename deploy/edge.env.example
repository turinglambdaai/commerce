# Commerce HTTP edge only. Copy to /etc/commerce/edge.env.
# Never put PERMIT_PRIVATE_KEY_PATH or any issuer signing secret here.
COMMERCE_ROLE=edge
COMMERCE_DB_PATH=/var/lib/commerce/commerce.sqlite
COMMERCE_ENVIRONMENT=test
COMMERCE_PORT=8080
COMMERCE_LISTEN_IP=127.0.0.1
PANCAKE_MERCHANT_ID=MER_your_merchant_id
PANCAKE_MERCHANT_KEY_PATH=/etc/commerce-secrets/edge/pancake-merchant.pem
PANCAKE_WEBHOOK_TEST_KEY_PATH=/etc/commerce-secrets/edge/pancake-test-public.pem
PANCAKE_WEBHOOK_PRODUCTION_KEY_PATH=/etc/commerce-secrets/edge/pancake-production-public.pem
