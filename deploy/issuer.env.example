# Commerce issuer/projector only. Copy to /etc/commerce/issuer.env.
# Never put Pancake merchant signing material in the issuer environment.
# The bundled Taskly catalog is demo-only and will refuse production signing.
COMMERCE_ROLE=issuer
COMMERCE_DB_PATH=/var/lib/commerce/commerce.sqlite
COMMERCE_ENVIRONMENT=test
COMMERCE_POLL_SECONDS=2
COMMERCE_ISSUER=com.example
COMMERCE_WORKER_OWNER=commerce-issuer
PERMIT_KEY_ID=key-2026
PERMIT_PRIVATE_KEY_PATH=/etc/commerce-secrets/issuer/permit-private.pem
PERMIT_TRUST_STORE_PATH=/etc/commerce-secrets/issuer/trust-store.json
