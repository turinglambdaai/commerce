# Commerce Alipay Basic Collection example (server only)
#
# Copy these variable names into a restricted service environment. Never
# commit real credentials or pass production signing keys through chat.
ALIPAY_ENV=sandbox
ALIPAY_APP_ID=replace-with-sandbox-app-id
ALIPAY_SELLER_ID=replace-with-matching-seller-id
ALIPAY_PRIVATE_KEY_PATH=/secure/alipay/sandbox-merchant-private-key.pem
ALIPAY_PUBLIC_KEY_PATH=/secure/alipay/sandbox-alipay-public-key.pem

COMMERCE_DATABASE_PATH=/var/lib/commerce/commerce.sqlite
COMMERCE_HTTP_PORT=8765
ALIPAY_NOTIFY_URL=https://your-approved-domain.example/webhooks/alipay
ALIPAY_RETURN_URL=https://your-approved-domain.example/order-result

# HTTPS must terminate at a trusted proxy forwarding only:
# POST /webhooks/alipay --> 127.0.0.1:8765
# Use that public HTTPS address as the checkout notify_url.
#
# Example: racket examples/alipay-service.rkt (after restricted env setup).
# The callback needs an immutable checkout binding, merchant_external_id
# equal to the generated out_trade_no, provider=alipay, CNY exponent=2.
# See docs/alipay-vibe-pay.md.
