# Copy to deploy/commerce.env and fill in. Secret paths must exist
# inside the container (mount them read-only).
COMMERCE_DB_PATH=/data/commerce.sqlite
COMMERCE_PORT=8080
COMMERCE_LISTEN_IP=0.0.0.0
COMMERCE_POLL_SECONDS=2
COMMERCE_ENVIRONMENT=test
COMMERCE_ISSUER=com.example
COMMERCE_WORKER_OWNER=commerce-docker
PERMIT_KEY_ID=key-2026
PERMIT_PRIVATE_KEY_PATH=/run/secrets/permit-private.pem
PERMIT_TRUST_STORE_PATH=/run/secrets/trust-store.json
PANCAKE_MERCHANT_ID=MER_your_merchant_id
PANCAKE_MERCHANT_KEY_PATH=/run/secrets/pancake-merchant.pem
PANCAKE_WEBHOOK_TEST_KEY_PATH=/run/secrets/pancake-test-public.pem
PANCAKE_WEBHOOK_PRODUCTION_KEY_PATH=/run/secrets/pancake-production-public.pem
